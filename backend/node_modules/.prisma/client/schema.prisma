// CarniSaaS - Prisma Schema
// Optimized for PostgreSQL (Supabase) + Multi-Tenant Architecture
// Currency: CLP (Int), Weights: kg (Decimal)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// CORE SAAS & AUTH
// ==========================================

model Tenant {
  id        String   @id @default(cuid())
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones Globales
  usuarios              Usuario[]
  categorias            Categoria[]
  productos             Producto[]
  preciosCanal          PrecioCanal[]
  clientes              Cliente[]
  estadosCuenta         EstadoCuenta[]
  turnosCaja            TurnoCaja[]
  ventas                Venta[]
  detallesVenta         DetalleVenta[]
  lotes                 Lote[]
  despostes             Desposte[]
  movimientosInventario MovimientoInventario[]
}

model Usuario {
  id        String   @id @default(cuid())
  tenant_id String
  nombre    String
  email     String   @unique
  role      String   @default("CAJERO") // CAJERO, ADMIN, OWNER
  createdAt DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenant_id], references: [id])
  turnosCaja TurnoCaja[]
}

// ==========================================
// MÓDULO: INVENTARIO Y TRAZABILIDAD (Lotes/Reses)
// ==========================================

enum CalidadRes {
  A
  B
  C
  V
  U
  N
}

model Lote {
  id              String     @id @default(cuid())
  tenant_id       String
  numero_caravana String? // Identificador único de la res
  peso_inicial    Decimal    @db.Decimal(10, 3)
  peso_actual     Decimal    @db.Decimal(10, 3)
  costo_total     Int // CLP
  calidad         CalidadRes @default(V)
  proveedor       String?
  fecha_ingreso   DateTime   @default(now())
  esta_despostado Boolean    @default(false)

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  despostes Desposte[]

  @@unique([tenant_id, numero_caravana])
}

model Desposte {
  id              String   @id @default(cuid())
  tenant_id       String
  lote_id         String
  fecha_desposte  DateTime @default(now())
  merma_total_kg  Decimal  @db.Decimal(10, 3)
  rendimiento_pct Float // Porcentaje de carne aprovechada

  tenant   Tenant            @relation(fields: [tenant_id], references: [id])
  lote     Lote              @relation(fields: [lote_id], references: [id])
  detalles DetalleDesposte[]
}

model DetalleDesposte {
  id          String  @id @default(cuid())
  desposte_id String
  producto_id String
  cantidad_kg Decimal @db.Decimal(10, 3)

  desposte Desposte @relation(fields: [desposte_id], references: [id])
}

// ==========================================
// MÓDULO: CATÁLOGO Y PRECIOS MULTI-CANAL
// ==========================================

model Categoria {
  id        String   @id @default(cuid())
  tenant_id String
  nombre    String
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  productos Producto[]

  @@unique([tenant_id, nombre])
}

model Producto {
  id           String   @id @default(cuid())
  tenant_id    String
  categoria_id String
  nombre       String
  sku          String?
  stock_actual Decimal  @default(0) @db.Decimal(10, 3)
  createdAt    DateTime @default(now())

  tenant        Tenant                 @relation(fields: [tenant_id], references: [id])
  categoria     Categoria              @relation(fields: [categoria_id], references: [id])
  preciosCanal  PrecioCanal[]
  detallesVenta DetalleVenta[]
  movimientos   MovimientoInventario[]

  @@unique([tenant_id, sku])
}

enum CanalVenta {
  VITRINA
  MAYORISTA
  CANAL_ENTERO
}

model PrecioCanal {
  id          String     @id @default(cuid())
  tenant_id   String
  producto_id String
  canal       CanalVenta
  precio_kilo Int // CLP

  tenant   Tenant   @relation(fields: [tenant_id], references: [id])
  producto Producto @relation(fields: [producto_id], references: [id])

  @@unique([tenant_id, producto_id, canal])
}

// ==========================================
// MÓDULO: CLIENTES Y CRÉDITOS (FIADOS)
// ==========================================

model Cliente {
  id                 String   @id @default(cuid())
  tenant_id          String
  nombre             String
  rut                String?
  telefono           String?
  limite_credito     Int      @default(0)
  credito_disponible Int      @default(0)
  deuda_total        Int      @default(0)
  createdAt          DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenant_id], references: [id])
  estadosCuenta EstadoCuenta[]
  ventas        Venta[]

  @@unique([tenant_id, rut])
}

enum TipoMovimientoCuenta {
  CARGO_POR_VENTA
  ABONO_EFECTIVO
  ABONO_TRANSFERENCIA
}

model EstadoCuenta {
  id          String               @id @default(cuid())
  tenant_id   String
  cliente_id  String
  tipo        TipoMovimientoCuenta
  monto       Int
  descripcion String?
  fecha       DateTime             @default(now())

  tenant  Tenant  @relation(fields: [tenant_id], references: [id])
  cliente Cliente @relation(fields: [cliente_id], references: [id])
}

// ==========================================
// MÓDULO: VENTAS Y CONTROL DE CAJA
// ==========================================

enum EstadoTurno {
  ABIERTO
  CERRADO
}

model TurnoCaja {
  id           String      @id @default(cuid())
  tenant_id    String
  usuario_id   String
  fecha_inicio DateTime    @default(now())
  fecha_fin    DateTime?
  estado       EstadoTurno @default(ABIERTO)

  // Resumen de dinero
  monto_apertura          Int @default(0)
  total_ventas_dia        Int @default(0) // Dinero por ventas hoy
  total_abonos_fiados     Int @default(0) // Dinero por deudas antiguas
  total_esperado_efectivo Int @default(0) // Suma de lo anterior + apertura

  fisico_declarado Int? @default(0)
  descuadre        Int? @default(0)

  tenant  Tenant  @relation(fields: [tenant_id], references: [id])
  usuario Usuario @relation(fields: [usuario_id], references: [id])
  ventas  Venta[]
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  FIAR
}

model Venta {
  id          String     @id @default(cuid())
  tenant_id   String
  turno_id    String
  cliente_id  String?
  canal_venta CanalVenta
  total       Int
  metodo_pago MetodoPago
  createdAt   DateTime   @default(now())

  tenant   Tenant         @relation(fields: [tenant_id], references: [id])
  turno    TurnoCaja      @relation(fields: [turno_id], references: [id])
  cliente  Cliente?       @relation(fields: [cliente_id], references: [id])
  detalles DetalleVenta[]
}

model DetalleVenta {
  id              String  @id @default(cuid())
  tenant_id       String
  venta_id        String
  producto_id     String
  cantidad_kg     Decimal @db.Decimal(10, 3)
  precio_unitario Int
  subtotal        Int

  tenant   Tenant   @relation(fields: [tenant_id], references: [id])
  venta    Venta    @relation(fields: [venta_id], references: [id])
  producto Producto @relation(fields: [producto_id], references: [id])
}

// ==========================================
// AUDITORÍA DE STOCK
// ==========================================

enum TipoMovimientoStock {
  ENTRADA_DESPOSTE
  SALIDA_VENTA
  AJUSTE_MANUAL
  MERMA
}

model MovimientoInventario {
  id          String              @id @default(cuid())
  tenant_id   String
  producto_id String
  cantidad    Decimal             @db.Decimal(10, 3)
  tipo        TipoMovimientoStock
  referencia  String? // ID de Venta o Desposte
  createdAt   DateTime            @default(now())

  tenant   Tenant   @relation(fields: [tenant_id], references: [id])
  producto Producto @relation(fields: [producto_id], references: [id])
}
